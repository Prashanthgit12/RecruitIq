PORT=5000
NODE_ENV=development

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=interview_room

# Alternatively specify the full database URL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_room

# JWT configuration
JWT_SECRET=super_secret_interview_room_token_key_12345
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Client URL)
CORS_ORIGIN=http://localhost:5173

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=interviews@smartroom.com

